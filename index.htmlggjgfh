<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ZIP · mass image ext changer → PNG</title>
  <!-- JSZip library -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
  <!-- FileSaver for download -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/FileSaver.js/2.0.5/FileSaver.min.js"></script>
  <style>
    * {
      box-sizing: border-box;
      font-family: 'Segoe UI', Roboto, system-ui, -apple-system, sans-serif;
    }
    body {
      background: linear-gradient(145deg, #f6f9fc 0%, #e6f0f5 100%);
      min-height: 100vh;
      margin: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
    }
    .card {
      max-width: 820px;
      width: 100%;
      background: rgba(255,255,255,0.85);
      backdrop-filter: blur(4px);
      border-radius: 2.5rem;
      box-shadow: 0 25px 50px -12px rgba(0,0,0,0.3), 0 4px 18px 0 rgba(0,0,0,0.08);
      padding: 2.5rem 2.2rem;
      transition: all 0.2s ease;
      border: 1px solid rgba(255,255,255,0.5);
    }
    h1 {
      font-weight: 600;
      font-size: 2.1rem;
      letter-spacing: -0.02em;
      color: #0b2b3f;
      margin-top: 0.2rem;
      margin-bottom: 0.3rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      flex-wrap: wrap;
    }
    .subhead {
      color: #2c5770;
      font-weight: 400;
      font-size: 1rem;
      border-left: 4px solid #3a8bb0;
      padding-left: 1rem;
      margin-bottom: 2rem;
      background: rgba(58, 139, 176, 0.06);
      border-radius: 0 12px 12px 0;
      padding: 0.7rem 1.2rem;
    }
    .drop-zone {
      border: 2px dashed #b6d2e2;
      border-radius: 2rem;
      padding: 2.8rem 1.5rem;
      text-align: center;
      background: #f2faff;
      transition: 0.25s;
      cursor: pointer;
      margin-bottom: 1.8rem;
      position: relative;
    }
    .drop-zone:hover, .drop-zone.dragover {
      border-color: #2a7a9e;
      background: #e1f0fa;
      box-shadow: inset 0 2px 8px rgba(0,60,100,0.08);
    }
    .drop-zone i {
      font-size: 2.8rem;
      display: block;
      margin-bottom: 0.5rem;
      color: #2c7b9e;
    }
    .drop-zone p {
      margin: 0.5rem 0;
      color: #1d4c64;
      font-weight: 500;
    }
    .drop-zone .hint {
      font-size: 0.9rem;
      color: #4a6f84;
      background: #dcecf7;
      display: inline-block;
      padding: 0.2rem 1.2rem;
      border-radius: 40px;
      margin-top: 0.5rem;
    }
    #fileInput {
      display: none;
    }
    .file-status {
      background: #ffffffcc;
      backdrop-filter: blur(2px);
      padding: 0.8rem 1.2rem;
      border-radius: 60px;
      border: 1px solid #c7dde9;
      margin-bottom: 1.5rem;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 0.8rem;
    }
    .file-status span {
      font-weight: 500;
      color: #0f3f57;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .badge {
      background: #1c6b89;
      color: white;
      border-radius: 50px;
      padding: 0.1rem 1rem;
      font-size: 0.8rem;
      font-weight: 500;
    }
    .action-bar {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 0.8rem;
      margin: 1.8rem 0 0.8rem;
    }
    .btn {
      border: none;
      background: white;
      padding: 0.75rem 1.8rem;
      border-radius: 60px;
      font-weight: 600;
      font-size: 0.95rem;
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      box-shadow: 0 2px 8px rgba(0, 40, 60, 0.08);
      transition: 0.2s;
      cursor: pointer;
      border: 1px solid transparent;
      color: #0b3b52;
    }
    .btn-primary {
      background: #0b3b52;
      color: white;
      box-shadow: 0 8px 18px -8px rgba(10, 60, 90, 0.4);
    }
    .btn-primary:hover {
      background: #124c67;
      transform: scale(1.02);
      box-shadow: 0 10px 22px -8px #0b3b5280;
    }
    .btn-primary:disabled {
      opacity: 0.5;
      pointer-events: none;
      filter: grayscale(0.3);
    }
    .btn-outline {
      background: transparent;
      border: 1px solid #abc2d0;
    }
    .btn-outline:hover {
      background: #d7e6f0;
      border-color: #729bb3;
    }
    .btn-success {
      background: #1b7a5e;
      color: white;
    }
    .btn-success:hover {
      background: #1f8f6f;
    }
    .log-area {
      background: #0b212e;
      border-radius: 1.4rem;
      padding: 1rem 1.4rem;
      margin-top: 1.8rem;
      color: #c1dcec;
      font-family: 'JetBrains Mono', 'Fira Code', monospace;
      font-size: 0.8rem;
      max-height: 180px;
      overflow-y: auto;
      border: 1px solid #2a4b5e;
      box-shadow: inset 0 4px 8px rgba(0,0,0,0.3);
    }
    .log-area p {
      margin: 0.2rem 0;
      line-height: 1.5;
      word-break: break-word;
    }
    .log-area .log-success { color: #83d0b7; }
    .log-area .log-info { color: #a3c9e0; }
    .log-area .log-error { color: #f7a68b; }
    .clear-log {
      background: transparent;
      border: none;
      color: #6f9bb3;
      float: right;
      cursor: pointer;
      font-size: 0.7rem;
      text-decoration: underline dotted;
    }
    .footer {
      margin-top: 1.2rem;
      font-size: 0.75rem;
      color: #3f6f87;
      text-align: center;
      border-top: 1px solid #c3dae7;
      padding-top: 1.2rem;
    }
    .flex {
      display: flex;
      gap: 0.6rem;
      flex-wrap: wrap;
    }
    @media (max-width: 550px) {
      .card { padding: 1.8rem 1rem; }
      h1 { font-size: 1.7rem; }
    }
  </style>
</head>
<body>
<div class="card">
  <h1>📦 PNG·Forge</h1>
  <div class="subhead">
    ⚡ Upload a ZIP with 7000+ images · all extensions become <strong>.png</strong> · download as ZIP
  </div>

  <!-- drop zone -->
  <div class="drop-zone" id="dropZone">
    <div>📁</div>
    <p><strong>Drop your ZIP file here</strong> or click to browse</p>
    <div class="hint">Supports .zip · 7000+ images</div>
    <input type="file" id="fileInput" accept=".zip">
  </div>

  <!-- file status -->
  <div class="file-status" id="fileStatus">
    <span id="fileNameDisplay">📎 No ZIP selected</span>
    <span class="badge" id="fileCountBadge">0 images</span>
  </div>

  <!-- actions -->
  <div class="action-bar">
    <div class="flex">
      <button class="btn btn-primary" id="convertBtn" disabled>⚡ Convert &amp; download</button>
      <button class="btn btn-outline" id="clearBtn">✕ Clear</button>
    </div>
    <button class="btn btn-outline" id="sampleBtn" style="font-size:0.85rem;">📄 generate sample ZIP</button>
  </div>

  <!-- log console -->
  <div class="log-area" id="logArea">
    <button class="clear-log" id="clearLogBtn">clear log</button>
    <p>📋 ready · upload a ZIP archive</p>
  </div>
  <div class="footer">
    all images keep original numeric basename · extension forced to .png
  </div>
</div>

<script>
  (function() {
    // ---------- DOM refs ----------
    const dropZone = document.getElementById('dropZone');
    const fileInput = document.getElementById('fileInput');
    const fileNameDisplay = document.getElementById('fileNameDisplay');
    const fileCountBadge = document.getElementById('fileCountBadge');
    const convertBtn = document.getElementById('convertBtn');
    const clearBtn = document.getElementById('clearBtn');
    const sampleBtn = document.getElementById('sampleBtn');
    const logArea = document.getElementById('logArea');
    const clearLogBtn = document.getElementById('clearLogBtn');

    // state
    let currentZipFile = null;            // File object (original zip)
    let currentZipEntries = [];           // array of { name, data (Uint8Array) } after unzip

    // ---------- helpers ----------
    function log(msg, type = 'info') {
      const p = document.createElement('p');
      p.textContent = msg;
      if (type === 'success') p.className = 'log-success';
      else if (type === 'error') p.className = 'log-error';
      else p.className = 'log-info';
      logArea.appendChild(p);
      logArea.scrollTop = logArea.scrollHeight;
    }

    function clearLog() {
      logArea.innerHTML = '';
      // re-add clear button and initial hint
      const clearBtnLog = document.createElement('button');
      clearBtnLog.className = 'clear-log';
      clearBtnLog.id = 'clearLogBtn';
      clearBtnLog.textContent = 'clear log';
      logArea.appendChild(clearBtnLog);
      const p = document.createElement('p');
      p.textContent = '📋 log cleared';
      p.className = 'log-info';
      logArea.appendChild(p);
      // re-bind clear log
      document.getElementById('clearLogBtn')?.addEventListener('click', clearLog);
    }

    // update UI status
    function updateStatus(file) {
      if (file) {
        fileNameDisplay.innerHTML = `📎 ${file.name}`;
        const count = currentZipEntries.length;
        fileCountBadge.textContent = count > 0 ? `${count} images` : '0 images';
        convertBtn.disabled = (count === 0);
      } else {
        fileNameDisplay.innerHTML = '📎 No ZIP selected';
        fileCountBadge.textContent = '0 images';
        convertBtn.disabled = true;
        currentZipEntries = [];
      }
    }

    // ---------- core: process zip file ----------
    function processZipFile(file) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = async (e) => {
          try {
            const arrayBuffer = e.target.result;
            const zip = await JSZip.loadAsync(arrayBuffer);
            const entries = [];
            let imageCount = 0;

            // collect all file entries (skip folders)
            for (const [relPath, zipEntry] of Object.entries(zip.files)) {
              if (zipEntry.dir) continue;
              // get file extension
              const ext = relPath.split('.').pop()?.toLowerCase() || '';
              // consider images: common extensions (including jpg, jpeg, png, gif, bmp, webp, tiff, ico, etc)
              // but we will convert ANY file to .png (keep numeric basename)
              // However we only want to keep images? The spec says "7000 pictures" – we convert all files
              // that are likely images. But to be safe, we accept any file, but we check if it's an image.
              // For pure conversion we convert every file in zip, but only if it's an image? The description:
              // "সব গুলো পিকচার যেমন 1.jpg বা যেকোনো একটেনশন থাকুক ... সব গুলো সংখ্যা সেম থাকবে শুধু এক্সটেনশন টা পরিবর্তন হয়ে png"
              // => all pictures, regardless of extension, become .png. We will convert every file that has an image signature?
              // But to be robust, we will convert every file that has a known image extension (or if binary image).
              // Better: we filter by "is image" via extension, but we also want to preserve numeric basename.
              // We'll accept: jpg, jpeg, png, gif, bmp, webp, tiff, tif, ico, heic, heif, avif, svg (but svg is xml)
              // In real use, if someone puts 7000 jpg, we convert to png. We'll filter by extension.
              const imageExtensions = ['jpg','jpeg','png','gif','bmp','webp','tiff','tif','ico','heic','heif','avif','svg','psd','ai','eps','raw','cr2','nef','arw','dng'];
              if (!imageExtensions.includes(ext)) {
                // skip non-image files (like .txt, .pdf etc) – but we keep if it's an image
                continue;
              }

              // read as Uint8Array
              const data = await zipEntry.async('uint8array');
              // get basename (without extension)
              const base = relPath.substring(0, relPath.lastIndexOf('.')) || relPath;
              // We want to keep the numeric name as is, but if basename has path, we take the last part after '/'
              let namePart = base.includes('/') ? base.split('/').pop() : base;
              // if namePart is empty, fallback to 'image'
              if (!namePart) namePart = 'image';
              // ensure it's numeric? we don't force, but we keep name.
              // The spec says "সব গুলো সংখ্যা সেম থাকবে" meaning numbers stay same.
              // We'll use the basename as is, but force .png
              const newName = `${namePart}.png`;
              entries.push({ name: newName, data: data });
              imageCount++;
            }

            if (entries.length === 0) {
              reject(new Error('No image files found in the ZIP. Please upload a ZIP containing images.'));
              return;
            }

            currentZipEntries = entries;
            resolve(entries);
          } catch (err) {
            reject(err);
          }
        };
        reader.onerror = () => reject(new Error('Failed to read file'));
        reader.readAsArrayBuffer(file);
      });
    }

    // ---------- handle file input ----------
    async function handleFile(file) {
      if (!file || file.type !== 'application/zip' && !file.name.toLowerCase().endsWith('.zip')) {
        log('❌ Please select a valid .zip file', 'error');
        return;
      }
      try {
        log(`📂 Processing "${file.name}" ...`, 'info');
        const entries = await processZipFile(file);
        currentZipFile = file;
        updateStatus(file);
        log(`✅ Done! Found ${entries.length} images.`, 'success');
      } catch (err) {
        log(`❌ Error: ${err.message}`, 'error');
        currentZipFile = null;
        currentZipEntries = [];
        updateStatus(null);
      }
    }

    // ---------- UI events ----------
    // click drop zone -> file input
    dropZone.addEventListener('click', () => fileInput.click());

    // drag & drop
    dropZone.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropZone.classList.add('dragover');
    });
    dropZone.addEventListener('dragleave', () => {
      dropZone.classList.remove('dragover');
    });
    dropZone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropZone.classList.remove('dragover');
      const file = e.dataTransfer.files[0];
      if (file) {
        fileInput.files = e.dataTransfer.files;
        handleFile(file);
      }
    });

    fileInput.addEventListener('change', (e) => {
      const file = e.target.files[0];
      if (file) {
        handleFile(file);
      } else {
        // reset
        currentZipFile = null;
        currentZipEntries = [];
        updateStatus(null);
      }
      // reset input so same file can be re-uploaded
      fileInput.value = '';
    });

    // clear button
    clearBtn.addEventListener('click', () => {
      currentZipFile = null;
      currentZipEntries = [];
      updateStatus(null);
      log('🧹 Cleared ZIP data', 'info');
      fileInput.value = '';
    });

    // clear log
    clearLogBtn?.addEventListener('click', clearLog);
    // re-bind after possible re-create (we use event delegation)
    document.addEventListener('click', function(e) {
      if (e.target && e.target.id === 'clearLogBtn') {
        clearLog();
      }
    });

    // ---------- convert & download ----------
    convertBtn.addEventListener('click', async () => {
      if (currentZipEntries.length === 0) {
        log('⚠️ No images to convert. Upload a ZIP first.', 'error');
        return;
      }

      try {
        convertBtn.disabled = true;
        convertBtn.textContent = '⏳ packing ...';
        log(`🔄 Converting ${currentZipEntries.length} images to .png ...`, 'info');

        const newZip = new JSZip();
        for (const entry of currentZipEntries) {
          // entry.name already has .png extension
          newZip.file(entry.name, entry.data);
        }

        const blob = await newZip.generateAsync({ type: 'blob' });
        const baseName = currentZipFile ? currentZipFile.name.replace(/\.zip$/i, '') : 'converted';
        const downloadName = `${baseName}_png.zip`;

        saveAs(blob, downloadName);
        log(`✅ Download started: "${downloadName}" (${currentZipEntries.length} images)`, 'success');
      } catch (err) {
        log(`❌ Conversion error: ${err.message}`, 'error');
      } finally {
        convertBtn.disabled = false;
        convertBtn.textContent = '⚡ Convert & download';
      }
    });

    // ---------- sample ZIP generator (for demo) ----------
    sampleBtn.addEventListener('click', async () => {
      try {
        sampleBtn.disabled = true;
        sampleBtn.textContent = '⏳ generating ...';
        log('📦 Generating sample ZIP with 50 dummy images (1.jpg ... 50.jpg) ...', 'info');

        const zip = new JSZip();
        // create 50 tiny jpg-like images (1x1 pixel fake jpeg) for demo
        // minimal valid JPEG (grey 1x1)
        const jpegBytes = new Uint8Array([
          0xFF, 0xD8, 0xFF, 0xE0, 0x00, 0x10, 0x4A, 0x46, 0x49, 0x46, 0x00, 0x01, 0x01, 0x00, 0x00, 0x01,
          0x00, 0x01, 0x00, 0x00, 0xFF, 0xDB, 0x00, 0x43, 0x00, 0x08, 0x06, 0x06, 0x07, 0x06, 0x05, 0x08,
          0x07, 0x07, 0x07, 0x09, 0x09, 0x08, 0x0A, 0x0C, 0x14, 0x0D, 0x0C, 0x0B, 0x0B, 0x0C, 0x19, 0x12,
          0x13, 0x0F, 0x14, 0x1D, 0x1A, 0x1F, 0x1E, 0x1D, 0x1A, 0x1C, 0x1C, 0x20, 0x24, 0x2E, 0x27, 0x20,
          0x22, 0x2C, 0x23, 0x1C, 0x1C, 0x28, 0x37, 0x29, 0x2C, 0x30, 0x31, 0x34, 0x34, 0x34, 0x1F, 0x27,
          0x39, 0x3D, 0x38, 0x32, 0x3C, 0x2E, 0x33, 0x34, 0x32, 0xFF, 0xC0, 0x00, 0x0B, 0x08, 0x00, 0x01,
          0x00, 0x01, 0x01, 0x01, 0x11, 0x00, 0xFF, 0xC4, 0x00, 0x14, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00,
          0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0xFF,
          0xDA, 0x00, 0x08, 0x01, 0x01, 0x00, 0x00, 0x3F, 0x00, 0x00, 0xFF, 0xD9
        ]);

        for (let i = 1; i <= 50; i++) {
          zip.file(`${i}.jpg`, jpegBytes);
        }
        // also add a few with other extensions: .png, .gif, .bmp? we'll add as png dummy.
        // add 5 extra .png dummy
        for (let i = 51; i <= 55; i++) {
          zip.file(`${i}.png`, jpegBytes);
        }

        const blob = await zip.generateAsync({ type: 'blob' });
        saveAs(blob, 'sample_images.zip');
        log('✅ Sample ZIP downloaded (55 images). Upload it to test conversion.', 'success');
      } catch (err) {
        log(`❌ Sample generation error: ${err.message}`, 'error');
      } finally {
        sampleBtn.disabled = false;
        sampleBtn.textContent = '📄 generate sample ZIP';
      }
    });

    // init
    updateStatus(null);
  })();
</script>
</body>
</html>
